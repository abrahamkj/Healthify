{
  "expo": {
    "name": "Healthify",
    "slug": "healthify",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "splash": {
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.healthify.app"
    },
    "android": {
      "package": "com.healthify.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      }
    },
    "web": {},
    "plugins": [
      ["expo-secure-store"],
      ["./plugins/withHealthKit"]
    ]
  }
}
